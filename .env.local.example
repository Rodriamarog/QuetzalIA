# OpenAI API key — used for query rewriting and final answer generation
OPENAI_API_KEY=sk-...

# Hetzner RAG API server URL (the Express server running the agentic RAG loop)
HETZNER_RAG_URL=http://YOUR_HETZNER_IP:3002

# Bearer token to authenticate with the RAG API server
RAG_API_KEY=your-rag-api-key-here
